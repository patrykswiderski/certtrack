{
  "name": "@certtrack/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "base.js",
    "nestjs.js",
    "react.js",
    "boundaries.js"
  ],
  "exports": {
    "./base": "./base.js",
    "./nestjs": "./nestjs.js",
    "./react": "./react.js",
    "./boundaries": "./boundaries.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  },
  "devDependencies": {
    "@certtrack/tsconfig": "workspace:*",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.0.0 <6.1.0"
  }
}
